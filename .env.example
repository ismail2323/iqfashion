# Veritabani (Neon/Supabase). DATABASE_URL = havuzlanmis baglanti, DIRECT_URL = migrate icin dogrudan baglanti
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/iqfashion"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/iqfashion"

# Oturum/CSRF icin zorunlu, en az 32 karakter rastgele (openssl rand -base64 48)
SESSION_SECRET=""

# Ilk kurulum (seed) super admin
SEED_ADMIN_NAME="Yavuz"
SEED_ADMIN_EMAIL="admin@iqfashion.local"
SEED_ADMIN_PASSWORD=""

# AI: referans uygulamayla BIREBIR ayni degisken adlari (Groq vision).
# Vercel > referans proje > Settings > Environment Variables icindeki GROQ_API_KEYS degerini buraya kopyalayin.
GROQ_API_KEYS="anahtar1,anahtar2,anahtar3"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# Istege bagli yedek saglayici (bos birakilirsa kullanilmaz)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview,gemini-flash-latest,gemini-3.1-flash-lite"

# Urun gorselleri (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Saglayici sirasi: once Groq (hizli, ~0.6sn), olmazsa Gemini
AI_SIRA="groq,gemini"
